# Never commit signing key material (see WRITEUP.md §3 and tools/govlib/integrity.py).
# The Ed25519 private key must live outside this repo entirely;
# these patterns are defense in depth only, not the actual control.
*private_key*
*.pem
*.hex
signing_key*

# Internal working plan, not part of the deliverable repo. Kept locally.
docs/PLAN.md

# Claude Code session state (worktrees used for the preflight); not deliverable.
.claude/

# Regenerable: python3 tools/simulate_run.py --keep
runs/_simulation_last/
runs/.hook_errors.log

# Transient run-state pointers, rewritten by every run
runs/.current
runs/.last

# Build artifact: regenerate with `python3 tools/gov.py bundle --out dist`
dist/
